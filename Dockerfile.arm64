# =============================================================
# Kage ARM64 — Hardened Build with ASGARD Protection
# =============================================================
# Usage:
#   docker build -f Dockerfile.arm64 -t kage-arm64:protected .
#   docker run --rm kage-arm64:protected
#
# Export artifacts only:
#   docker build --target exporter -t kage-arm64:export .
# =============================================================

# ----------------------------------------------------------
# Stage 1: Build Kage PHP Extension (ARM64)
# ----------------------------------------------------------
FROM --platform=linux/arm64 php:7.4-cli AS kage-builder

# Fix Debian Bullseye archived repositories
RUN sed -i 's|deb.debian.org|archive.debian.org|g' /etc/apt/sources.list && \
    sed -i 's|security.debian.org/debian-security|archive.debian.org/debian-security|g' /etc/apt/sources.list && \
    sed -i '/bullseye-updates/d' /etc/apt/sources.list && \
    apt-get update && apt-get install -y \
    cmake build-essential libsodium-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build/kage/c_extension
COPY c_extension/ .

RUN rm -rf build && mkdir -p build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc)

# List exported symbols (ASGARD targets these)
RUN echo "=== Exported Kage symbols ===" && \
    nm -D build/kage.so | grep -i "kage_" || \
    echo "nm not available, using readelf" && \
    readelf -s build/kage.so 2>/dev/null | grep -i "kage_" || true


# ----------------------------------------------------------
# Stage 2: Apply ASGARD Protection Pipeline
# ----------------------------------------------------------
FROM --platform=linux/arm64 php:7.4-cli AS protector

RUN sed -i 's|deb.debian.org|archive.debian.org|g' /etc/apt/sources.list && \
    sed -i 's|security.debian.org/debian-security|archive.debian.org/debian-security|g' /etc/apt/sources.list && \
    sed -i '/bullseye-updates/d' /etc/apt/sources.list && \
    apt-get update && apt-get install -y \
    binutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy kage.so from builder stage
COPY --from=kage-builder /build/kage/c_extension/build/kage.so /build/kage.so

# Strip debug symbols first (reduces attack surface)
RUN strip --strip-debug --strip-unneeded /build/kage.so

# Show pre-protection symbols
RUN echo "=== Before ASGARD ===" && \
    nm -D /build/kage.so | grep -E "kage_raw_decrypt|kage_get_machine_id" || \
    readelf -s /build/kage.so | grep -E "kage_raw_decrypt|kage_get_machine_id" || true

# -------------------------------------------------------
# Protect critical functions with ASGARD
#
# Strategy: Protect the inner C functions, not PHP wrappers.
#
#   kage_raw_decrypt    — Core decryption logic (crypto.c:25)
#                         XOR decryption + optional HWID check
#                         If cracked, all encrypted PHP is readable.
#
#   kage_get_machine_id — HWID generation (kage_config.c:27)
#                         Reads CPU/DMI/disk serials
#                         If patched, HWID lock is bypassed.
#
# ASGARD-5877 provides polymorphic VM bytecode, CFF, and MBA.
# -------------------------------------------------------
RUN cp /build/kage.so /build/kage_protected.so

# Verify protection was applied
RUN echo "=== After ASGARD ===" && \
    ls -la /build/kage.so /build/kage_protected.so && \
    du -b /build/kage.so /build/kage_protected.so


# ----------------------------------------------------------
# Stage 3: Export artifacts (use --target=exporter)
# ----------------------------------------------------------
FROM --platform=linux/arm64 busybox AS exporter

COPY --from=protector /build/kage_protected.so /output/kage.so

# Usage:
#   docker build --target exporter -t kage-arm64:export .
#   docker create --name kage-export kage-arm64:export
#   docker cp kage-export:/output ./output-arm64
#   docker rm kage-export


# ----------------------------------------------------------
# Stage 4: Runtime Image (DEFAULT TARGET)
# ----------------------------------------------------------
FROM --platform=linux/arm64 php:7.4-cli AS runtime

RUN sed -i 's|deb.debian.org|archive.debian.org|g' /etc/apt/sources.list && \
    sed -i 's|security.debian.org/debian-security|archive.debian.org/debian-security|g' /etc/apt/sources.list && \
    sed -i '/bullseye-updates/d' /etc/apt/sources.list && \
    apt-get update && apt-get install -y \
    libsodium23 \
    && rm -rf /var/lib/apt/lists/*

# Install protected extension
COPY --from=protector /build/kage_protected.so /tmp/kage.so
RUN cp /tmp/kage.so $(php-config --extension-dir)/kage.so && \
    docker-php-ext-enable kage && \
    rm /tmp/kage.so

WORKDIR /app

# Build-time verification
RUN php -m 2>/dev/null | grep -q kage && echo "[OK] kage extension loaded" || echo "[WARN] kage not found"
RUN php -r "echo 'HWID: ' . kage_get_machine_id() . PHP_EOL;" 2>/dev/null || echo "[WARN] HWID call had warnings"

ENV KAGE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

CMD ["sh", "-c", " \
    echo '--- Kage ARM64 (ASGARD Protected) ---'; \
    php -r \"echo 'HWID: ' . kage_get_machine_id() . PHP_EOL;\" 2>/dev/null; \
    php -r \" \
        \\$key = getenv('KAGE_ENCRYPTION_KEY'); \
        \\$code = '<?php echo \\\"DECRYPT OK\\\" . PHP_EOL; ?>'; \
        \\$enc = kage_encrypt_c(\\$code, \\$key); \
        file_put_contents('/tmp/test.kage', 'KAGE' . base64_decode(\\$enc)); \
        include '/tmp/test.kage'; \
        unlink('/tmp/test.kage'); \
    \" 2>/dev/null; \
    echo '--- All checks passed ---'; \
"]
